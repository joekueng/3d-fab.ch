{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessNoSandbox",
    "e2e:local": "E2E_SUITE=fullstack E2E_SLOWMO=300 playwright test --headed",
    "e2e:dev": "E2E_SUITE=smoke playwright test",
    "e2e:full": "E2E_SUITE=fullstack playwright test",
    "e2e:states": "E2E_SUITE=ui-states playwright test",
    "e2e:ui": "E2E_SUITE=fullstack playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:typecheck": "tsc -p tsconfig.e2e.json --noEmit",
    "check:shop-ssr": "node --test scripts/shop-ssr.test.mjs",
    "check:e2e-routes": "node scripts/check-e2e-routes.mjs",
    "check:i18n": "node scripts/check-i18n-parity.mjs",
    "check:ui-reuse": "node scripts/check-ui-reuse.mjs",
    "serve:ssr:frontend": "node dist/frontend/server/server.mjs"
  },
  "private": true,
  "engines": {
    "node": "^22.0.0"
  },
  "dependencies": {
    "@angular/cdk": "22.2.0",
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/forms": "22.2.0",
    "@angular/material": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/platform-browser-dynamic": "22.2.0",
    "@angular/platform-server": "22.2.0",
    "@angular/router": "22.2.0",
    "@angular/ssr": "22.2.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@types/three": "^0.186.0",
    "escape-html": "^1.0.3",
    "express": "^5.2.1",
    "rxjs": "~7.8.2",
    "three": "^0.186.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.2.0",
    "@angular/cli": "22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^26.6.3",
    "jasmine-core": "~7.0.2",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "typescript": "~7.0.2"
  },
  "overrides": {
    "tar": "7.5.6"
  }
}
