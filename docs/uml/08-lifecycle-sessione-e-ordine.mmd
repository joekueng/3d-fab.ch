flowchart TB
    classDef quote fill:#e8f0ff,stroke:#2f5bd1,color:#222;
    classDef order fill:#e9f8ef,stroke:#2f8f46,color:#222;
    classDef note fill:#fff6d6,stroke:#a66c00,color:#222;

    subgraph QuoteLifecycle[Lifecycle sessione preventivo]
        Q1[ACTIVE<br/>preventivo modificabile]:::quote
        Q2[CAD_ACTIVE<br/>sessione tecnica gestita da admin]:::quote
        Q3[CONVERTED<br/>bloccata e trasformata in ordine]:::quote
        Q4[EXPIRED<br/>sessione scaduta o cookie non valido]:::quote

        Q1 -->|checkout standard| Q3
        Q1 -->|scadenza o cleanup| Q4
        Q1 -->|totale CAD da backoffice| Q2
        Q2 -->|checkout CAD| Q3
    end

    subgraph OrderLifecycle[Lifecycle ordine e pagamento]
        O1[PENDING_PAYMENT<br/>payment = PENDING]:::order
        O2[PENDING_PAYMENT<br/>payment = REPORTED]:::order
        O3[IN_PRODUCTION]:::order
        O4[SHIPPED]:::order
        O5[COMPLETED]:::order

        O1 -->|cliente segnala pagamento| O2
        O1 -->|admin puo avviare lavorazione| O3
        O2 -->|backoffice prende in carico| O3
        O3 -->|spedizione| O4
        O4 -->|chiusura| O5
    end

    Q3 -->|createOrderFromQuote| O1
    Note1[Email e documenti nascono alla creazione ordine.<br/>Email di spedizione parte quando lo stato passa a SHIPPED.]:::note
    O1 -.-> Note1
