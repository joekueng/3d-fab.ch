flowchart TB
    classDef quote fill:#e8f0ff,stroke:#2f5bd1,color:#222;
    classDef order fill:#e9f8ef,stroke:#2f8f46,color:#222;
    classDef note fill:#fff6d6,stroke:#a66c00,color:#222;

    subgraph QuoteLifecycle[Quote session lifecycle]
        Q1[ACTIVE<br/>editable quote]:::quote
        Q2[CAD_ACTIVE<br/>admin-managed technical session]:::quote
        Q3[CONVERTED<br/>locked and converted into an order]:::quote
        Q4[EXPIRED<br/>expired session or invalid cookie]:::quote

        Q1 -->|standard checkout| Q3
        Q1 -->|expiration or cleanup| Q4
        Q1 -->|CAD total from back office| Q2
        Q2 -->|CAD checkout| Q3
    end

    subgraph OrderLifecycle[Order and payment lifecycle]
        O1[PENDING_PAYMENT<br/>payment = PENDING]:::order
        O2[PENDING_PAYMENT<br/>payment = REPORTED]:::order
        O3[IN_PRODUCTION]:::order
        O4[SHIPPED]:::order
        O5[COMPLETED]:::order

        O1 -->|customer reports payment| O2
        O1 -->|admin starts production| O3
        O2 -->|back office takes over| O3
        O3 -->|shipment| O4
        O4 -->|completion| O5
    end

    Q3 -->|createOrderFromQuote| O1
    Note1[Emails and documents are generated when the order is created.<br/>The shipping email is sent when the status changes to SHIPPED.]:::note
    O1 -.-> Note1
