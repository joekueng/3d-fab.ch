classDiagram
    direction LR

    class QuoteSession {
        +UUID id
        +String status
        +String sessionType
        +String materialCode
        +BigDecimal setupCostChf
        +BigDecimal cadHours
        +BigDecimal cadHourlyRateChf
        +UUID convertedOrderId
    }

    class QuoteLineItem {
        +UUID id
        +String lineItemType
        +String originalFilename
        +String displayName
        +Integer quantity
        +String materialCode
        +String quality
        +BigDecimal nozzleDiameterMm
        +BigDecimal layerHeightMm
        +Integer printTimeSeconds
        +BigDecimal materialGrams
        +BigDecimal unitPriceChf
        +String storedPath
    }

    class Customer {
        +UUID id
        +String customerType
        +String email
        +String phone
    }

    class Order {
        +UUID id
        +String status
        +String sourceType
        +String preferredLanguage
        +BigDecimal subtotalChf
        +BigDecimal setupCostChf
        +BigDecimal shippingCostChf
        +BigDecimal cadTotalChf
        +BigDecimal totalChf
    }

    class OrderItem {
        +UUID id
        +String itemType
        +String displayName
        +Integer quantity
        +String materialCode
        +BigDecimal unitPriceChf
        +BigDecimal lineTotalChf
        +String storedRelativePath
    }

    class Payment {
        +UUID id
        +String method
        +String status
        +BigDecimal amountChf
        +OffsetDateTime initiatedAt
        +OffsetDateTime reportedAt
        +OffsetDateTime receivedAt
    }

    class ShopProduct {
        +UUID id
        +String slug
        +String name
        +Boolean isFeatured
    }

    class ShopProductVariant {
        +UUID id
        +String sku
        +String variantLabel
        +String colorName
        +String internalMaterialCode
        +BigDecimal priceChf
    }

    class FilamentMaterialType {
        +Long id
        +String materialCode
        +Boolean isFlexible
        +Boolean isTechnical
    }

    class FilamentVariant {
        +Long id
        +String variantDisplayName
        +String colorName
        +BigDecimal costChfPerKg
        +BigDecimal stockSpools
    }

    class PricingPolicy {
        +Long id
        +String policyName
        +BigDecimal markupPercent
        +BigDecimal fixedJobFeeChf
        +BigDecimal cadCostChfPerHour
    }

    class PricingPolicyMachineHourTier {
        +Long id
        +BigDecimal tierStartHours
        +BigDecimal tierEndHours
        +BigDecimal machineCostChfPerHour
    }

    class PrinterMachine {
        +Long id
        +String printerDisplayName
        +Integer buildVolumeXMm
        +Integer buildVolumeYMm
        +Integer buildVolumeZMm
        +Integer powerWatts
    }

    class PrinterMachineProfile {
        +Long id
        +BigDecimal nozzleDiameterMm
        +String orcaMachineProfileName
        +Boolean isDefault
    }

    class MaterialOrcaProfileMap {
        +Long id
        +String orcaFilamentProfileName
        +Boolean isActive
    }

    class NozzleOption {
        +Long id
        +BigDecimal nozzleDiameterMm
        +BigDecimal extraNozzleChangeFeeChf
    }

    QuoteSession "1" --> "*" QuoteLineItem : contains
    QuoteSession "1" --> "0..1" Order : converted to
    Order "*" --> "1" Customer : belongs to
    Order "1" --> "*" OrderItem : contains
    Order "1" --> "0..1" Payment : payment

    ShopProduct "1" --> "*" ShopProductVariant : offers
    QuoteLineItem "*" --> "0..1" ShopProductVariant : optional shop source
    OrderItem "*" --> "0..1" ShopProductVariant : optional shop source

    QuoteLineItem "*" --> "0..1" FilamentVariant : print filament
    OrderItem "*" --> "0..1" FilamentVariant : production filament
    FilamentVariant "*" --> "1" FilamentMaterialType : typed as

    PricingPolicy "1" --> "*" PricingPolicyMachineHourTier : machine hour tiers
    PrinterMachine "1" --> "*" PrinterMachineProfile : Orca profiles
    MaterialOrcaProfileMap "*" --> "1" PrinterMachineProfile : per machine/nozzle
    MaterialOrcaProfileMap "*" --> "1" FilamentMaterialType : per material

    QuoteLineItem ..> NozzleOption : extra setup fee by nozzle mix
